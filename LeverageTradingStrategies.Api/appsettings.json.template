{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://localhost:5585"
      }
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "LogFilePath": "logs/trading-.log",
    "SqliteDb": "Data Source=db/leverage-trading.db",
    "Redis": "localhost:6379"
  },
  "AppSettings": {
    "Trading": {
      "SchwabTokenPath": "REPLACE_WITH_PATH_TO_YOUR_SCHWAB_TOKENS_JSON",
      "AccountNumber": "REPLACE_WITH_YOUR_SCHWAB_ACCOUNT_NUMBER",
      "UseSimulatedBroker": true
    },
    "Tradier": {
      "Token": "REPLACE_WITH_YOUR_TRADIER_LIVE_TOKEN",
      "AccountId": "REPLACE_WITH_YOUR_TRADIER_LIVE_ACCOUNT_ID",
      "VirtualAccountId": "REPLACE_WITH_YOUR_TRADIER_SANDBOX_ACCOUNT_ID",
      "VirtualToken": "REPLACE_WITH_YOUR_TRADIER_SANDBOX_TOKEN",
      "UseSandbox": true
    },
    "VerticalSpread": {
      "Enabled": true,
      "MarkingCronSchedule": "0 */5 9-16 ? * MON-FRI"
    },
    "TqqqWeekly": {
      "Enabled": false,
      "Symbol": "TQQQ",

      "AllocatedCapital": 1000,
      "CompoundingEnabled": false,

      "BaseSizeFraction": 0.98,
      "VolBoostFraction": 1.25,
      "VolLookbackDays": 14,
      "VolHistoryMaxReadings": 252,
      "VolHistoryMinReadings": 60,
      "VolPercentileThreshold": 0.90,

      "TierHighMultiplier": 1.08177,
      "TierMidMultiplier": 1.07,
      "TierLowMultiplier": 1.025,
      "TierProfitHighThreshold": 0.003,

      "AvgDownTrigger": -0.05,
      "AvgDownFraction": 0.30,

      "MondayAvgDownTrigger": -0.03,
      "MondayAvgDownFraction": 0.20,

      "CloseStopPct": -0.20,
      "EntryDayCloseStopPct": -0.20,

      "ForceCloseWeekly": true,
      "ForceCloseHourEt": 14,

      "CronSchedule": "0 */5 9-16 ? * MON-FRI"
    },
    "TqqqAgent": {
      "Enabled": false,
      "AnthropicApiKey": "REPLACE_WITH_YOUR_ANTHROPIC_API_KEY",
      "AnthropicModel": "claude-sonnet-5",
      "AnthropicMaxTokens": 1024,
      "AnthropicMaxToolIterations": 6,

      "IntervalMinutes": 5,

      "EquityUsageFraction": 0.85,
      "MaxNotionalCeiling": 450,

      "ConsecutiveLossLimit": 3,
      "DailyLossStopPct": 0.05,

      "MarketOpenHourEt": 9,
      "MarketOpenMinuteEt": 30,
      "MarketCloseHourEt": 16,
      "MarketCloseMinuteEt": 0,
      "EntryWindowStartHourEt": 9,
      "EntryWindowStartMinuteEt": 35,
      "EntryWindowEndHourEt": 15,
      "EntryWindowEndMinuteEt": 40,
      "ForceFlattenHourEt": 15,
      "ForceFlattenMinuteEt": 45,

      "MinConfidenceToAct": 0.0,
      "RecentDecisionsShownToClaude": 5,
      "MaxRecentDecisionsKept": 20
    }
  }
}
